/* ==========================================================================
   EQUINOX DESIGN SYSTEM — Vercel Monochromatic Pure Black Style
   ========================================================================== */

* {
    font-family: 'Satoshi', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI Variable Display', 'Segoe UI', sans-serif;
    outline: none;
}

/* --- Window & Base --- */
QMainWindow, QDialog, QWidget#pageWelcome {
    background-color: #000000;
    color: #FFFFFF;
}

/* --- Menu Bar & Menus --- */
QMenuBar {
    background-color: #000000;
    color: #A1A1AA;
    border-bottom: 1px solid #1F1F23;
    padding: 2px 4px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected, QMenuBar::item:pressed {
    background-color: #18181B;
    color: #FFFFFF;
}

QMenu {
    background-color: #0A0A0A;
    color: #FFFFFF;
    border: 1px solid #27272A;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 14px;
    border-radius: 4px;
    font-size: 13px;
}

QMenu::item:selected {
    background-color: #18181B;
    color: #FFFFFF;
}

QMenu::item:disabled {
    color: #52525B;
}

QMenu::separator {
    height: 1px;
    background-color: #27272A;
    margin: 4px 6px;
}

/* --- ToolBar (Minimal Compact) --- */
QToolBar {
    background-color: #000000;
    border-top: none;
    border-bottom: 1px solid #1F1F23;
    border-left: none;
    border-right: none;
    spacing: 6px;
    padding: 6px 12px;
}

QToolButton {
    background-color: transparent;
    color: #A1A1AA;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 6px 8px;
    font-size: 12px;
    font-weight: 500;
}

QToolButton:hover {
    background-color: #121212;
    border: 1px solid #27272A;
    color: #FFFFFF;
}

QToolButton:pressed, QToolButton:checked {
    background-color: #18181B;
    border: 1px solid #3F3F46;
    color: #FFFFFF;
}

QToolButton:disabled {
    color: #3F3F46;
}

/* --- Buttons --- */
QPushButton {
    background-color: #0A0A0A;
    color: #FFFFFF;
    border: 1px solid #27272A;
    border-radius: 6px;
    padding: 6px 14px;
    font-size: 13px;
    font-weight: 500;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #18181B;
    border: 1px solid #3F3F46;
}

QPushButton:pressed {
    background-color: #27272A;
}

QPushButton:disabled {
    background-color: #09090B;
    border: 1px solid #18181B;
    color: #52525B;
}

/* Primary Action Button (Inverted Vercel) */
QPushButton:default {
    background-color: #FFFFFF;
    color: #000000;
    border: 1px solid #FFFFFF;
    font-weight: 600;
}

QPushButton:default:hover {
    background-color: #E4E4E7;
    border: 1px solid #E4E4E7;
}

QPushButton:default:pressed {
    background-color: #D4D4D8;
}

/* --- Inputs & Text Edits --- */
QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox {
    background-color: #0A0A0A;
    color: #FFFFFF;
    border: 1px solid #27272A;
    border-radius: 6px;
    padding: 6px 10px;
    selection-background-color: #FFFFFF;
    selection-color: #000000;
    font-size: 13px;
}

QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus, QSpinBox:focus {
    border: 1px solid #FFFFFF;
    background-color: #0D0D0E;
}

QLineEdit:disabled, QPlainTextEdit:disabled, QTextEdit:disabled {
    background-color: #09090B;
    border: 1px solid #18181B;
    color: #52525B;
}

/* Monospace inputs for passwords and keys */
QLineEdit[echoMode="2"] {
    font-family: 'JetBrains Mono', 'Geist Mono', 'Consolas', monospace;
    letter-spacing: 2px;
}

/* --- TreeViews & TableViews (Minimalist Table) --- */
QTreeView, QTableView, QListView {
    background-color: #000000;
    alternate-background-color: #050505;
    color: #FFFFFF;
    border: none;
    gridline-color: transparent;
    selection-background-color: #18181B;
    selection-color: #FFFFFF;
    outline: none;
}

QTreeView::item, QTableView::item {
    padding: 8px 10px;
    border-bottom: 1px solid #141417;
    min-height: 28px;
}

QTreeView::item:hover, QTableView::item:hover {
    background-color: #0D0D0E;
}

QTreeView::item:selected, QTableView::item:selected {
    background-color: #18181B;
    color: #FFFFFF;
}

QTreeView::item:selected:active, QTableView::item:selected:active {
    background-color: #1E1E24;
    color: #FFFFFF;
}

/* Header Columns */
QHeaderView {
    background-color: #000000;
    border: none;
}

QHeaderView::section {
    background-color: #000000;
    color: #71717A;
    padding: 8px 10px;
    border-top: none;
    border-left: none;
    border-right: none;
    border-bottom: 1px solid #27272A;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QHeaderView::section:hover {
    color: #FFFFFF;
    background-color: #0A0A0A;
}

/* --- Tabs --- */
QTabWidget::pane {
    border: 1px solid #27272A;
    border-radius: 8px;
    background-color: #000000;
    top: -1px;
}

QTabBar::tab {
    background-color: transparent;
    color: #71717A;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 500;
}

QTabBar::tab:selected {
    color: #FFFFFF;
    border-bottom: 2px solid #FFFFFF;
}

QTabBar::tab:hover:!selected {
    color: #E4E4E7;
}

/* --- Splitters --- */
QSplitter::handle {
    background-color: #1F1F23;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

/* --- ScrollBars --- */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #27272A;
    min-height: 24px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background: #3F3F46;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
    border: none;
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #27272A;
    min-width: 24px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal:hover {
    background: #3F3F46;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
    border: none;
    width: 0px;
}

/* --- CheckBox & RadioButton --- */
QCheckBox, QRadioButton {
    color: #FFFFFF;
    spacing: 8px;
    font-size: 13px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    background-color: #0A0A0A;
    border: 1px solid #27272A;
    border-radius: 4px;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border: 1px solid #3F3F46;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #FFFFFF;
    border: 1px solid #FFFFFF;
    image: none;
}

/* --- ToolTip --- */
QToolTip {
    color: #FFFFFF;
    background-color: #121212;
    border: 1px solid #27272A;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

/* --- Database & Preview Specific --- */
DatabaseWidget, DatabaseWidget #groupView, DatabaseWidget #tagView {
    background-color: #000000;
    border: none;
}

DatabaseWidget #groupView::item, DatabaseWidget #tagView::item {
    padding: 6px 12px;
    border-radius: 6px;
    border-bottom: none;
}

DatabaseWidget #groupView::item:selected, DatabaseWidget #tagView::item:selected {
    background-color: #18181B;
    color: #FFFFFF;
}

EntryPreviewWidget, EntryPreviewWidget *[blendIn="true"] {
    background-color: #000000;
    border: none;
    color: #FFFFFF;
}

DatabaseOpenWidget #centralStack, DatabaseOpenWidget #publicSummaryLabel {
    border: 1px solid #27272A;
    background: #0A0A0A;
    border-radius: 8px;
}

/* Search Banner / Notification banner */
DatabaseWidget #SearchBanner {
    background-color: #0A0A0A;
    color: #FFFFFF;
    border: 1px solid #27272A;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: 500;
}
